FROM alpine:latest
ARG VERSION=dev
LABEL org.opencontainers.image.title="Aegis Agent" \
      org.opencontainers.image.description="Restic backups that report to Aegis Cloud. Based on Backrest." \
      org.opencontainers.image.source="https://github.com/LePhiAnhDev/aegis-agent" \
      org.opencontainers.image.licenses="GPL-3.0" \
      org.opencontainers.image.version="${VERSION}"
RUN apk --no-cache add tini ca-certificates curl bash rclone openssh tzdata docker-cli && \
    rclone selfupdate --stable
RUN mkdir -p /tmp

ARG TARGETPLATFORM
# The binaries (restic checked against its SHA256SUMS) and license texts are
# staged per platform by scripts/aegis-release.sh.
COPY --chmod=0755 $TARGETPLATFORM/aegis-agent /aegis-agent
COPY --chmod=0755 $TARGETPLATFORM/docker-entrypoint /docker-entrypoint
COPY --chmod=0755 $TARGETPLATFORM/restic /bin/restic
COPY --chmod=0644 licenses/LICENSE licenses/LICENSE.restic licenses/NOTICE /licenses/

ENTRYPOINT ["/sbin/tini", "--", "/docker-entrypoint"]
CMD ["/aegis-agent"]
